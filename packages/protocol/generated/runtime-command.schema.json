{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "runtime.initialize"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "workspacePath": {
              "type": "string",
              "minLength": 1
            },
            "dshHomePath": {
              "type": "string",
              "minLength": 1
            },
            "profileDigest": {
              "$ref": "#/$defs/__schema3"
            },
            "pluginPackDigest": {
              "$ref": "#/$defs/__schema3"
            },
            "pluginPackOverlayPath": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "persona": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "runId",
            "workspacePath",
            "dshHomePath",
            "profileDigest",
            "pluginPackDigest",
            "provider",
            "model",
            "persona"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "run.prompt"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "runId",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "run.followup"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "required": [
            "runId",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "run.cancel"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "cause": {
              "type": "string",
              "enum": [
                "user",
                "parent"
              ]
            }
          },
          "required": [
            "runId",
            "cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "approval.decide"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "callId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "decision": {
              "type": "string",
              "enum": [
                "allowed_once",
                "rejected"
              ]
            }
          },
          "required": [
            "runId",
            "callId",
            "decision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/__schema0"
        },
        "messageId": {
          "$ref": "#/$defs/__schema1"
        },
        "sentAt": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "const": "runtime.shutdown"
        },
        "payload": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "runId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "sentAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 1
    },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
