{
  "name": "@whalepod/runtime-dsh",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./coordination": {
      "types": "./dist/coordination-runtime.d.ts",
      "development": "./src/coordination-runtime.ts",
      "default": "./dist/coordination-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./managed-draft": {
      "types": "./dist/managed-draft-worker.d.ts",
      "development": "./src/managed-draft-worker.ts",
      "default": "./dist/managed-draft-worker.js"
    },
    "./managed-draft-broker": {
      "types": "./dist/managed-draft-broker.d.ts",
      "development": "./src/managed-draft-broker.ts",
      "default": "./dist/managed-draft-broker.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-app-boot": "catalog:",
    "@deepseek-ai/dsh-base": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-replay": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@whalepod/protocol": "workspace:*"
  }
}
