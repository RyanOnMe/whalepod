  "extends": "./tsconfig.json",
  "compilerOptions": { "composite": false, "noEmit": true, "rootDir": "../.." },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
